# for clrf and lf differences 
* text=auto

# binary 
*.png binary 
*.jpeg binary 
*.jpg binary 
*.zip binary 
*.tar binary 
*.tar.gz binary 
*.parquet binary 
*.db binary 

# files that require specific eol 
*.sh text eol=lf 
*.ps text eol=crlf 
*.bat text eol=crlf 
Makefile text eol=lf

# ignores changes in big lockfiles and does not count as a change + dont show as a language 
go.sum -diff linguist-generated
vendor/**       linguist-vendored
migrations/**   linguist-vendored

# this way git has a nice golang diff 
*.go    diff=golang

.github/       export-ignore


experiments/**/*.html binary
experiments/**/*.json binary
experiments/ export-ignore

*.psd    filter=lfs diff=lfs merge=lfs -text
*.onnx   filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
datasets/**/*.csv filter=lfs diff=lfs merge=lfs -text
*.sh text eol=lf
*.cgi text eol=lf
